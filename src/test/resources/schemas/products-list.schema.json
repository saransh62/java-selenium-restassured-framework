{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "productsList / searchProduct response",
  "type": "object",
  "required": ["responseCode", "products"],
  "properties": {
    "responseCode": {"type": "integer", "const": 200},
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "price", "brand", "category"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "price": {"type": "string", "pattern": "^Rs\\. \\d+$"},
          "brand": {"type": "string", "minLength": 1},
          "category": {
            "type": "object",
            "required": ["usertype", "category"],
            "properties": {
              "usertype": {
                "type": "object",
                "required": ["usertype"],
                "properties": {"usertype": {"type": "string"}}
              },
              "category": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
